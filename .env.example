# Copier en .env pour les exécutions locales (le .env est ignoré par git).
# En CI, ces mêmes noms sont des GitHub Secrets.

# France Travail — https://francetravail.io (application + API Offres d'emploi v2)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Adzuna — https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Sheets
# En local : chemin vers le fichier JSON du compte de service.
GOOGLE_APPLICATION_CREDENTIALS=
# En CI : contenu complet du JSON (secret GCP_SERVICE_ACCOUNT_JSON).
GCP_SERVICE_ACCOUNT_JSON=
# ID du classeur = la partie entre /d/ et /edit dans l'URL de la feuille.
SHEET_ID=
